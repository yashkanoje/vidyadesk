# A password with special characters must be URL-encoded (@ becomes %40).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/leadagent
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/leadagent_test
# Which model answers: anthropic (Claude) or gemini (free tier: test data only, never real students)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
FERNET_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
PUBLIC_BASE_URL=
# Dashboard login cookie: generate with python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# SESSION_HTTPS_ONLY=false   # only for local testing over plain http
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v24.0
# Optional tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# Optional, for the Odia comparison in evals
# SARVAM_API_KEY=
